<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Accent" Color="#CEC681"/>
  <SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="SecondaryInk" Color="#BCBEBE"/><SolidColorBrush x:Key="BorderLine" Color="#20808080"/><SolidColorBrush x:Key="SurfaceBrush" Color="#12FFFFFF"/><SolidColorBrush x:Key="TileBrush" Color="#18FFFFFF"/><SolidColorBrush x:Key="AccentInk" Color="#202020"/>
  <!-- Fluent 2 semantic interaction tokens. Colors are refreshed for theme/high contrast. -->
  <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D"/>
  <SolidColorBrush x:Key="ControlHoverOverlay" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="ControlPressedOverlay" Color="#18FFFFFF"/>
  <SolidColorBrush x:Key="NeutralTrack" Color="#9B9B9B"/>
  <ControlTemplate x:Key="FluentButtonTemplate" TargetType="Button"><Grid>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
    <Border x:Name="Interaction" Background="Transparent" CornerRadius="4"/>
    <Border x:Name="FocusRing" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="4" Opacity="0" Margin="1"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Interaction" Property="Background" Value="{DynamicResource ControlHoverOverlay}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Interaction" Property="Background" Value="{DynamicResource ControlPressedOverlay}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource TileBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="32"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="12,6"/>
   <Setter Property="Template" Value="{DynamicResource FluentButtonTemplate}"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource TileBrush}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="1,1,1,2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Immediate preferences use a switch presentation with native WPF toggle/keyboard semantics. -->
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="SwitchTrack" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource Ink}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse x:Name="SwitchKnob" Width="12" Height="12" Margin="3,0" Fill="{DynamicResource Ink}" HorizontalAlignment="Left" VerticalAlignment="Center"/></Border>
   <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   <Border x:Name="SwitchFocus" Grid.ColumnSpan="2" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="4" Margin="-3" Visibility="Collapsed"/>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource AccentInk}"/><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchKnob" Property="Width" Value="14"/><Setter TargetName="SwitchKnob" Property="Height" Value="14"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource TileBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ChoiceBorder" CornerRadius="4" Background="{Binding Background,RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,6,28,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
    <TextBlock IsHitTestVisible="False" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource Ink}" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <Border x:Name="ChoiceFocus" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="4" Visibility="Collapsed"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ChoiceFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ChoiceItem" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ChoiceItem" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceItem" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="32"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="10"/>
   <Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Margin="0,0,0,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="False">
     <Track.DecreaseRepeatButton><RepeatButton Style="{x:Null}" OverridesDefaultStyle="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" VerticalAlignment="Center" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,0,-5,0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Style="{x:Null}" OverridesDefaultStyle="True" Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Fill="{DynamicResource TileBrush}"/><Ellipse x:Name="Dot" Fill="{DynamicResource Accent}" Width="10" Height="10"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Width" Value="12"/><Setter TargetName="Dot" Property="Height" Value="12"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Dot" Property="Width" Value="8"/><Setter TargetName="Dot" Property="Height" Value="8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Style="{x:Null}" OverridesDefaultStyle="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" VerticalAlignment="Center" Background="{DynamicResource NeutralTrack}" CornerRadius="2" Margin="-5,0,0,0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track><Border x:Name="SliderFocus" IsHitTestVisible="False" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="4" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>
